build/gocache/
build/gomodcache/

# Build outputs
dist/
*.exe

# Config with secrets (keep cfg.yml.template)
cfg.yml

# Model files (large binaries, mounted at runtime)
models/*

# IDE / tools
.vscode/
.idea/
.claude/

# Self-signed certificate (not needed in Docker)
cert/

# Build artifacts & temp files
rsrc
web/index.html.orig

# Runtime logs
avatar.log

# OS garbage
.DS_Store
Thumbs.db