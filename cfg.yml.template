# Avatar PC — 数字人 API 配置
# 将此文件放在 avatar.exe 同目录下，启动时自动读取。
#
# 接入阿里云百炼 DashScope 实时 WebSocket API：
#   ASR: Qwen-Audio-3.0-ASR-Flash-Streaming (WebSocket run-task 协议)
#   TTS: Qwen3-TTS-Flash-Realtime (WebSocket realtime 协议)
#   LLM: 千问对话模型 (chat/completions)
#   API Key: https://help.aliyun.com/zh/model-studio/get-api-key

asr:
  # 华北2（北京）: wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
  url: "wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference"
  model: "qwen-audio-3.0-asr-flash-streaming"
  format: "pcm"
  sample_rate: 16000

llm:
  # 百炼兼容 OpenAI chat/completions，可复用同一个 URL 结构
  url: "https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions"
  model: "qwen-plus"
  # 人偶的名字（会写入系统提示词，可自行修改）
  name: "小然"

tts:
  # Qwen-TTS Realtime WebSocket API，北京地域
  url: "wss://dashscope.aliyuncs.com/api-ws/v1/realtime"
  model: "qwen3-tts-flash-realtime"
  voice: "Cherry"
  format: "pcm"
  sample_rate: 24000

# 百炼 API Key（从 https://bailian.console.aliyun.com 获取）
api_key: ""